# Supabase (https://supabase.com/dashboard/project/ndgelpjogufewgqtddzd)
NEXT_PUBLIC_SUPABASE_URL=https://ndgelpjogufewgqtddzd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway (https://vercel.com/dashboard/ai)
# Either AI_GATEWAY_API_KEY or run on Vercel with OIDC. Direct provider keys also accepted.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5
CAPITAL_UNDER_MANAGEMENT_USD=100000

# Optional: X (Twitter) API. If empty, scrapers fall back to public-frontend (nitter / rss-bridge).
X_BEARER_TOKEN=
# Comma-separated nitter instances tried in order
NITTER_INSTANCES=https://nitter.poast.org,https://nitter.privacydev.net,https://nitter.net

# Cron protection (must be passed via x-cron-secret on POST /api/ingest/*)
CRON_SECRET=change-me
